{
  "request": {
    "method": "GET",
    "urlPath": "/api/recommendations",
    "queryParameters": {
      "userId": {
        "equalTo": "999"
      }
    }
  },
  "response": {
    "status": 404,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "userId": 999,
      "error": "No recommendations found"
    }
  }
}
