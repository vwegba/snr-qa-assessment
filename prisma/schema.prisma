generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model AppUser {
  id                         BigInt        @id
  is_deleted                 Boolean       @default(false)
  username                   String        @db.Text
  firstname                  String        @db.Text
  lastname                   String        @db.Text
  password                   String        @db.Text
  email                      String        @db.Text
  nonlocked                  Boolean
  enabled                    Boolean
  last_time_password_updated DateTime      @default(dbgenerated("'1970-01-01 00:00:00'")) @db.DateTime(0)
  password_never_expires     Boolean       @default(false)
  cannot_change_password     Boolean       @default(false)
  AppUserRole                AppUserRole[]
  UserPhone                  UserPhone[]
}

model AppUserRole {
  appuser_id BigInt
  role_id    BigInt
  Role       Role    @relation(fields: [role_id], references: [id], map: "fk_app_user_role_role")
  AppUser    AppUser @relation(fields: [appuser_id], references: [id], map: "fk_app_user_role_user")

  @@id([appuser_id, role_id])
  @@index([role_id], map: "fk_app_user_role_role")
}

model Role {
  id          BigInt        @id
  name        String        @db.Text
  description String        @db.Text
  is_disabled Boolean       @default(false)
  AppUserRole AppUserRole[]
}

model UserPhone {
  id               Int     @id @default(autoincrement())
  user_id          BigInt
  phone_country_id Int
  phone            String  @db.VarChar(20)
  order_index      Int
  AppUser          AppUser @relation(fields: [user_id], references: [id], map: "fk_user_phone_user")

  @@index([user_id], map: "fk_user_phone_user")
}

model flyway_schema_history {
  installed_rank Int      @id
  version        String?  @db.VarChar(50)
  description    String   @db.VarChar(200)
  type           String   @db.VarChar(20)
  script         String   @db.VarChar(1000)
  checksum       Int?
  installed_by   String   @db.VarChar(100)
  installed_on   DateTime @default(now()) @db.Timestamp(0)
  execution_time Int
  success        Boolean

  @@index([success], map: "flyway_schema_history_s_idx")
}
